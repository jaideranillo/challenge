<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-008 §3.1/3.2: bridges every Logback log event into the OpenTelemetry SDK's
  SdkLoggerProvider bean (auto-configured by spring-boot-starter-opentelemetry), which the
  already-configured OTLP exporter ships to Loki. trace_id/span_id are attached automatically
  by OpenTelemetryAppender from the live OTel context - never hand-set (§3.2). The MDC keys
  below are the ones §3.2 puts on every delivery-pipeline log line.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <appender name="OpenTelemetry" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>false</captureExperimentalAttributes>
        <captureCodeAttributes>false</captureCodeAttributes>
        <captureMdcAttribute>delivery_id</captureMdcAttribute>
        <captureMdcAttribute>event_id</captureMdcAttribute>
        <captureMdcAttribute>client_id</captureMdcAttribute>
        <captureMdcAttribute>subscription_id</captureMdcAttribute>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="OpenTelemetry" />
    </root>
</configuration>
